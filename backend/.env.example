# Earthbucks API — environment configuration
# Copy this file to .env and fill in real values.

# SQLite for local dev. Swap for postgresql+psycopg://user:pw@host/db in prod.
DATABASE_URL=sqlite:///./earthbucks.db

# JWT secret — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-generate-a-real-one   # never ship this file's value; Railway sets its own
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5500,https://earthbux.net,https://www.earthbux.net
# Bot signature (scripts/bots/ebx_bots.py): a signup sending this value in the
# X-EBX-Bot-Key header is created with is_test=true. Leave empty to disable.
EBX_BOT_KEY=

# Contact us (2026-09-25/26). Every message is stored; it is ALSO emailed to
# CONTACT_TO when a mail route is set. Railway Hobby blocks SMTP, so use Resend:
#   RESEND_API_KEY from resend.com › API Keys; MAIL_FROM on a domain verified
#   there (send.earthbux.net). SMTP_* is the fallback (Pro plan / other hosts).
CONTACT_TO=jax@earthbux.net
RESEND_API_KEY=
MAIL_FROM=Earthbux <contact@send.earthbux.net>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
