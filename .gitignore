# ── Earthbucks .gitignore (project root) ─────────────────────────

# Python (backend/)
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.alembic_cache/

# SQLite databases (don't commit local DB state)
*.db
*.sqlite
*.sqlite3
# ...including every backup/migration copy of one. These were tracked until
# 2026-08-13; a public Railway build shouldn't carry real database state.
*.bak_*
*.db.bak*
*.migrated_*

# Environment / secrets
.env
.env.local
.env.*.local

# Node (frontend/)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
*.tsbuildinfo

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
